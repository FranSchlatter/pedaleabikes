{
    "name": "pedaleabikes",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "images:placeholders": "node scripts/generate-placeholders.mjs",
        "test": "vitest run",
        "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
        "admin:user": "node --env-file-if-exists=.env.local scripts/create-admin-user.mjs",
        "db:start": "supabase start",
        "db:stop": "supabase stop",
        "db:reset": "supabase db reset",
        "inventory:sample": "node scripts/generate-sample-inventory.mjs",
        "test:db": "vitest run --config vitest.integration.config.mts"
    },
    "dependencies": {
        "@hookform/resolvers": "7.0.6",
        "@supabase/ssr": "0.12.7",
        "@supabase/supabase-js": "2.119.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "lucide-react": "1.73.0",
        "motion": "14.13.0",
        "next": "16.4.6",
        "radix-ui": "1.8.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "7.92.0",
        "recharts": "3.10.1",
        "server-only": "0.0.1",
        "sonner": "2.0.8",
        "tailwind-merge": "3.7.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/turbopack": "4.3.3",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "9.39.5",
        "eslint-config-next": "16.4.6",
        "prettier": "3.10.1",
        "sharp": "0.35.5",
        "supabase": "3.2.0",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "vitest": "5.1.0"
    },
    "engines": {
        "node": ">=24.22.1",
        "npm": ">=11.10.0"
    }
}
