# URL pública del sitio (dominio propio). En Vercel, si no se define, se usa el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=https://pedaleabikes.com.ar

# Sistema de gestión (/admin) — Supabase. Ver SETUP.md.
# Project Settings → API (o "API Keys"): Project URL y publishable key (o anon key).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Solo para el script que crea el usuario (npm run admin:user). NO cargarla en Vercel.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
